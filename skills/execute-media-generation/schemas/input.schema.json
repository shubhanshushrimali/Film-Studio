{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execute Media Generation Request",
  "allOf": [
    {"$ref": "../../../schemas/common/request-envelope.schema.json"}
  ],
  "properties": {
    "payload": {
      "type": "object",
      "required": ["generation_package", "provider_routes"],
      "properties": {
        "generation_package": {"type": "object"},
        "provider_routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["request_id", "provider", "model", "capabilities"],
            "properties": {
              "request_id": {"type": "string", "minLength": 1},
              "provider": {"type": "string", "minLength": 1},
              "model": {"type": "string", "minLength": 1},
              "capabilities": {"type": "object"}
            },
            "additionalProperties": false
          }
        },
        "execution_policy": {
          "type": "object",
          "properties": {
            "dry_run": {"type": "boolean", "default": false},
            "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 64},
            "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
            "hard_cost_limit": {"type": "number", "minimum": 0},
            "currency": {"type": "string"}
          },
          "additionalProperties": false
        },
        "existing_jobs": {
          "type": "array",
          "items": {"type": "object"}
        }
      },
      "additionalProperties": false
    }
  },
  "unevaluatedProperties": false
}
